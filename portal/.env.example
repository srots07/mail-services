# Database for the subscription website (Neon / Supabase / any PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/portal?sslmode=require"

# Public URL of this website (no trailing slash)
APP_URL="http://localhost:3100"

# At least 32 random characters
SESSION_SECRET=""

# Razorpay (Dashboard -> Account & Settings -> API keys). Leave empty in development to use the mock.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard -> Webhooks: URL ${APP_URL}/api/billing/webhook, events subscription.*
RAZORPAY_WEBHOOK_SECRET=""
# Plan ids from Dashboard -> Subscriptions -> Plans
RAZORPAY_PLAN_MONTHLY=""
RAZORPAY_PLAN_YEARLY=""
# Prices shown on the website (the real amount is the Razorpay plan's)
PRICE_MONTHLY_LABEL="₹999 / month"
PRICE_YEARLY_LABEL="₹9,999 / year"

# Ed25519 private key that signs desktop licenses: run `npm run license:keygen`
LICENSE_SIGNING_KEY=""

TRIAL_DAYS="7"
MAX_DEVICES="2"
# Leave empty to offer the latest release published to UPDATES_DIR
DOWNLOAD_URL=""
# Folder with latest.json + installers, served at ${APP_URL}/updates for in-app auto-update (default: ./updates)
UPDATES_DIR=""
