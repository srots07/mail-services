{
  "name": "email-campaign-manager",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:check": "node --env-file=.env scripts/db-check.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "test:license": "node scripts/license-e2e.mjs",
    "test:openrouter": "node scripts/openrouter-live.mjs",
    "desktop:prepare": "node scripts/desktop-prepare.mjs",
    "desktop:start": "electron desktop",
    "desktop:dev": "npm run desktop:prepare && electron desktop",
    "desktop:build": "npm run desktop:prepare && electron-builder --win --config electron-builder.yml",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-three/fiber": "^9.8.1",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "nodemailer": "^10.1.1",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "^9.3.10",
    "server-only": "^0.0.1",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "dotenv": "^18.0.5",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "electron@44.6.0": true
  }
}

