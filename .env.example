# ---------------------------------------------------------------
# Database (PostgreSQL). Hosted providers (Neon, Supabase, Railway) work.
# Use sslmode=require for hosted databases.
# ---------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Max pooled DB connections per server process (use 1 for the local 'prisma dev' database)
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------
# Public base URL of the app (used for OAuth redirects and CSRF origin checks)
# ---------------------------------------------------------------
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------
# Secrets. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TOKEN_ENCRYPTION_KEY must decode to exactly 32 bytes (base64).
# ---------------------------------------------------------------
SESSION_SECRET=""
TOKEN_ENCRYPTION_KEY=""

# Set to "false" to disable new self-service registrations after creating your account.
ALLOW_REGISTRATION="true"

# Skip the sign-in screen and open the app as a single local owner account.
# Local development only: ignored when NODE_ENV=production.
AUTO_LOGIN="false"
AUTO_LOGIN_EMAIL="owner@localhost"

# ---------------------------------------------------------------
# OpenRouter (server-side only, never exposed to the browser)
# ---------------------------------------------------------------
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
# Groq API (fast fallback when OpenRouter is out of credits or unavailable)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
# Max parallel AI requests during generation
AI_CONCURRENCY="3"
AI_MAX_RETRIES="4"
AI_TIMEOUT_MS="45000"

# ---------------------------------------------------------------
# Google OAuth (Gmail API, gmail.send scope)
# ---------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/oauth/google/callback"

# ---------------------------------------------------------------
# Sending queue
# ---------------------------------------------------------------
EMAIL_BATCH_SIZE="10"
EMAIL_BATCH_DELAY_MS="60000"
MAX_EMAIL_RETRIES="3"

# ---------------------------------------------------------------
# Development-only mock providers. Ignored (forced to "real") when NODE_ENV=production.
#   AI_PROVIDER:    "openrouter" | "mock"
#   EMAIL_PROVIDER: "gmail" | "mock"
# ---------------------------------------------------------------
AI_PROVIDER="openrouter"
EMAIL_PROVIDER="gmail"

# Desktop subscriptions (read by npm run desktop:prepare; both are public). Leave empty to build without subscriptions.
PORTAL_URL=""
LICENSE_PUBLIC_KEY=""
